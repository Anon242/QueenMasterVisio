<UserControl x:Class="QueenMasterVisio.DeviceControl.DeviceControlForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QueenMasterVisio.DeviceControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <UserControl.Resources>
        <!-- Стиль для кнопок в стиле VS Code -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#C0C0C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
        </Style>

        <!-- Стиль для заголовков столбцов DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="ToggleButton" >
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#C0C0C0"/>
                    <Setter Property="BorderBrush" Value="#C0C0C0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="BorderBrush" Value="#C0C0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ячеек DataGrid -->
        <Style TargetType="DataGridCell" >
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2F0D9"/>
                    <Setter Property="Foreground" Value="#1E1E1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Показать данные из:" Margin="0,0,8,0"/>
                <ComboBox x:Name="comboDataSource" Width="120" SelectedIndex="0">
                    <ComboBoxItem Content="Страница" IsSelected="True"/>
                    <ComboBoxItem Content="Документ"/>
                    </ComboBox>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="15,0" Height="20" Background="#D0D0D0"/>

                <!-- Группа кнопок Ошибки/Предупреждения/Сообщения + кнопка Проверить с равной шириной, растянутой по горизонтали -->
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,0" Width="497">
                    <ToggleButton x:Name="buttonErrors" Content="Ошибки [0]" IsChecked="True" Checked="FilterToggle_Checked" Unchecked="FilterToggle_Unchecked"/>
                    <ToggleButton x:Name="buttonWarnings" Content="Предупреждения [0]" IsChecked="True" Checked="FilterToggle_Checked" Unchecked="FilterToggle_Unchecked"/>
                    <ToggleButton x:Name="buttonMessages" Content="Сообщения [0]" IsChecked="True" Checked="FilterToggle_Checked" Unchecked="FilterToggle_Unchecked"/>
                    <!-- Визуально отдельная кнопка Проверить -->
                    <Button x:Name="buttonCheck" Content="Проверить" Width="80" Margin="25,0,0,0" Background="#E8E8E8" BorderBrush="#C0C0C0" Click="buttonCheck_Click"/>
                </UniformGrid>

               
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid Grid.Row="1" x:Name="dataGrid" 
                  ItemsSource="{Binding Items}" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="None"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- Иконка -->
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" Width="10" Height="20" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Код -->
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Описание -->
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" MinWidth="200"/>

                <!-- Фигура -->
                <DataGridTextColumn Header="Фигура" Binding="{Binding Shape}" Width="Auto" MinWidth="100"/>

                <!-- Страница -->
                <DataGridTextColumn Header="Страница" Binding="{Binding Page}" Width="Auto" MinWidth="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

    
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>