<UserControl x:Class="QueenMasterVisio.Binding.BindingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QueenMasterVisio.Binding"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    
        
        <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Основной контент (два списка и кнопки) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левый список (древовидный) -->
            <TreeView x:Name="LeftTreeView" Grid.Column="0" Margin="0,0,5,0" MouseDoubleClick="LeftDoubleClick" >
            </TreeView>

            <!-- Кнопки управления -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="MoveRightButton" Content="→" Width="40" Height="30" Margin="5" 
                        ToolTip="Скопировать выбранный элемент из левого списка в правый" Click="MoveRightButton_Click" />
                <Button x:Name="DeleteButton" Content="✖" Width="40" Height="30" Margin="5" 
                        ToolTip="Удалить выбранный элемент из правого списка" Click="DeleteButton_Click" />
            </StackPanel>

            <!-- Правый список (простой) -->
            <ListBox x:Name="RightListBox" Grid.Column="2" Margin="5,0,0,0" MouseDoubleClick="RightClick" />
        </Grid>
    </Grid>
</UserControl>