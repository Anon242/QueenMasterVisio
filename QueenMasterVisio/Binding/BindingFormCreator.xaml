<UserControl x:Class="QueenMasterVisio.Binding.BindingFormCreator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QueenMasterVisio.Binding"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Поле "Название страницы" -->
            <RowDefinition Height="*" />
            <!-- Основной контент (списки + кнопки) -->
            <RowDefinition Height="Auto" />
            <!-- Кнопка сохранить -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Label + TextBox -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Название страницы:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="PageNameTextBox" Width="233" VerticalAlignment="Center" KeyUp="PageNameTextBox_KeyUp" />
        </StackPanel>

        <!-- Основной контент (два списка и кнопки управления) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="277*" />
                <ColumnDefinition Width="88*"/>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="365*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="LeftTreeView" Grid.Column="0" Margin="0,0,5,0" 
                      MouseDoubleClick="LeftDoubleClick" Grid.ColumnSpan="2" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="MoveRightButton" Content="→" Width="40" Height="30" Margin="5" 
                        ToolTip="Скопировать выбранный элемент из левого списка в правый" Click="MoveRightButton_Click" />
                <Button x:Name="DeleteButton" Content="✖" Width="40" Height="30" Margin="5" 
                        ToolTip="Удалить выбранный элемент из правого списка" Click="DeleteButton_Click" />
            </StackPanel>

            <ListBox x:Name="RightListBox" Grid.Column="3" Margin="5,0,0,0" 
                     MouseDoubleClick="RightClick" />
        </Grid>

        <!-- Кнопка Сохранить (некликабельна при IsEnabled = false) -->
        <Button x:Name="CreateButton" Grid.Row="2" Content="Создать страницу" 
                HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,5" 
                IsEnabled="False" Click="SaveButton_Click" />
    </Grid>
</UserControl>